# Copy this file to .env and fill in your own values
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fraudguard_db?retryWrites=true&w=majority
PORT=4000

# Layer 1: ML service (XGBoost + GraphSAGE blended scores). Falls back to the agent service if offline.
ML_SERVICE_URL=http://127.0.0.1:8080
# Layer 3: agent service (agent-service/run_service.py) - /investigate, and /predict fallback.
AGENT_SERVICE_URL=http://127.0.0.1:8001
# Only used by GET /system/health to report whether the LLM is actually up.
OLLAMA_URL=http://127.0.0.1:11434

# Investigation timeout. The agent takes ~10-16s per case and retries once.
INVESTIGATE_TIMEOUT_MS=60000
# Serve agent-service/data/cached_demo.json instead of calling the LLM (demo safety net).
AGENT_USE_CACHE=false
# live  = send the agent the current graph context from MongoDB (recommended)
# stored = let the agent use only its own stored profile
AGENT_CONTEXT_MODE=live
# Don't re-investigate the same account within this window; reuse its decision.
INVESTIGATION_COOLDOWN_MS=90000
# How long an agent "clear" downgrades a Layer-1 flag for that account.
AGENT_CLEAR_TTL_HOURS=24

# Enables POST /system/reset and simulation traffic (skips balance/confirm checks).
# Set to false for anything that isn't a demo.
DEMO_MODE=true

NEXT_PUBLIC_API_URL=http://localhost:4000

# --- agent-service/.env (run the agent with these so only the backend writes the DB) ---
# ACTION_BACKEND=simulated
# DATA_PROVIDER_MODE=csv     # mock if the ml-service CSVs are not available yet
